{
  "version": "7.3",
  "screens": [
    {
      "id": "REGISTER_ANIMAL",
      "title": "Register Animal",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "register_animal_form",
            "children": [
              {
                "type": "PhotoPicker",
                "label": "Photo of Animal",
                "name": "animal_photo",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 1
              },
              {
                "type": "TextInput",
                "label": "Name",
                "name": "name",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "label": "Breed",
                "name": "breed",
                "input-type": "text",
                "required": false,
                "helper-text": "e.g. Hereford, Angus, Brahman"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Gender",
                "name": "gender",
                "required": false,
                "data-source": [
                  {"id": "male",    "title": "Male"},
                  {"id": "female",  "title": "Female"},
                  {"id": "unknown", "title": "Unknown"}
                ]
              },
              {
                "type": "DatePicker",
                "label": "Date of Birth",
                "name": "date_of_birth",
                "required": false,
                "helper-text": "Approximate date is fine"
              },
              {
                "type": "TextInput",
                "label": "Weight (kg)",
                "name": "weight_kg",
                "input-type": "number",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Register Animal",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "name":          "${form.name}",
                    "breed":         "${form.breed}",
                    "gender":        "${form.gender}",
                    "date_of_birth": "${form.date_of_birth}",
                    "weight_kg":     "${form.weight_kg}",
                    "animal_photo":  "${form.animal_photo}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
